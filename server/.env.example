# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/champions_club?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Razorpay Payment Gateway (Indian Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Email Notifications (SendGrid / Resend)
EMAIL_SERVICE_API_KEY=
EMAIL_FROM=noreply@championsclub.com
